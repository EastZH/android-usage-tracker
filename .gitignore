# ---- 构建产物 ----
.gradle/
build/
app/build/
.cxx/
*.iml

# ---- 本机配置（含 SDK 路径，因机而异） ----
local.properties
.idea/

# 发布签名密钥。**绝不能入库** —— 泄露等于别人可以冒充你发布"更新"。
# 也绝不能弄丢 —— 换密钥后已装旧版的用户无法覆盖安装（签名不匹配）。
keystore.properties
*.jks
*.keystore

# ---- 本地工具链（自行下载的 Gradle 发行包） ----
.toolchain/

# ---- Python ----
__pycache__/
*.pyc

# ============================================================
#  数据：绝不入库
# ============================================================
# 手机端的数据库在手机上，不在这里。下面是 PC 端同步下来的副本 ——
# 它们是**个人使用记录**，推上去就公开了，且删掉也未必追得回来。
pc/data/
pc/*.db
pc/*.db-wal
pc/*.db-shm

# 发布产物，按需构建，不入库
*.apk
