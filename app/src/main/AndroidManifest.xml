<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      appop 型权限，不在运行时弹窗。授予方式有两条：
        1. adb shell appops set com.east.time GET_USAGE_STATS allow   （持久，重启后仍有效）
        2. 用户在 设置 → 应用 → 特殊应用权限 → 使用情况访问 里手动开启
      lint 会把它标成 ProtectedPermissions，这里是有意声明，忽略即可。
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- 亮屏提醒。Android 13+ 是运行时权限，用户开启开关时才申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

    <!--
      Android 11+ 的包可见性：不加这段，PackageManager 只能看到本应用，
      getApplicationInfo 抛 NameNotFoundException，界面上的 App 名称会全部退化成包名
      （实测 com.tencent.tim、com.v2ray.ang 都显示不出来）。
      这里只声明"能启动的 App"——正是我们会展示的那些，不必用 QUERY_ALL_PACKAGES 那种大权限。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>
